# Copy this file to `.local.env` (don't commit) and fill in your Supabase
# or Postgres connection string. Prisma v7+ expects the connection URL to be
# provided by the Prisma config (prisma.config.ts) or via the environment.
#
# Example Supabase connection string (replace placeholders):
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"
#
# Or a standard Postgres connection string:
# DATABASE_URL="postgres://username:password@host:5432/database"
#
# Quick test commands:
# - Use an environment override for a one-off push:
#   npx prisma db push --url="your-connection-string-here"
# - Or create a `.local.env` in the project root with the DATABASE_URL line above.
